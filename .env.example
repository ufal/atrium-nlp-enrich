# atrium-nlp-enrich — the published environment contract (atrium-project#60).
#
# Copy to `.env` and edit. Do not commit `.env`.
# (Add `.env` to this repo's .gitignore — it is not there yet.)
#
# NOT to be confused with annotation/env.example. That file configures the
# standalone Doccano / Label Studio annotation stack, has a different audience,
# and carries admin credentials. Keep the two separate; neither supersedes the
# other.
#
# This file is the COMPLETE ledger: every variable the api image's own
# configuration surface reads, with the default that is in the CODE. The curated
# partner-facing subset is the table in the hub's docs/k8s_deployment.md.
# Batch-pipeline knobs (ALTO_DIR, SAVE_CSV, TEITOK_OUTPUT_DIR, SUMMARY_* and the
# rest of api_util/summarize_nt_udp.py's ~15 variables) are deliberately NOT here:
# they belong to config_api.txt and the api_N_*.sh stages, which the api image
# drives as a subprocess and a deployment never configures directly.
#
# ── Read this before assuming an entry works ─────────────────────────────────
# Nothing here loads a .env file. No module imports python-dotenv, and
# docker-compose.yaml has no `env_file:`. Compose reads `.env` ONLY to expand
# ${VAR} inside docker-compose.yaml itself, so a variable reaches the container
# only if the `nlp-api` service's `environment:` block passes it through. Tags:
#
#   [compose + k8s]  passed through by docker-compose.yaml's nlp-api service,
#                    and settable in the k8s manifest's env: block.
#   [k8s / -e only]  NOT passed by docker-compose today — setting it in .env
#                    does nothing. Set it in the k8s manifest's env: block, or
#                    with `docker run -e VAR=...`.
#   [OVERRIDDEN]     worse than inert — docker-compose.yaml sets this as a
#                    LITERAL, so compose actively overrides whatever .env says.
#
# atrium-project#60 step 4 converts the [OVERRIDDEN] pair to ${VAR:-default} and
# adds the missing passthroughs. Until then these tags are the truth.
#
# ── A variable deliberately absent ───────────────────────────────────────────
# LOG_LEVEL is read by service/api.py:559 and is NOT listed here. It is withheld
# across all five repos until atrium-project#61 is verified green everywhere: in
# page-classification the same read is inert (a library module calls
# logging.basicConfig at import, and the entrypoint's own call has no
# force=True), and publishing a knob that works in four images and silently does
# nothing in the fifth is the defect atrium-project#58 was raised to stop.

# ── Backing services (atrium-project#63) ──────────────────────────────────────
# [compose + k8s] Attachable endpoints: point these at a self-hosted UDPipe 2 /
# NameTag 3, or at a local stub, with no code change and no rebuild.
#
# Leave BLANK rather than deleting the line. Blank means "unset" to every
# resolver that reads them, which is why docker-compose.yaml passes them as
# ${VAR:-} and config_api.txt:30-31 holds them as "${UDPIPE_URL:-<lindat>}" —
# the shell keeps the export attribute across `source`, so a bare assignment
# there would clobber a deployment-set value.
#
# Precedence, highest first:  --url flag > this variable > config_api.txt >
#                             module constant in api_util/call_*.py
#
# Unset, both fall back to the LINDAT public hosts:
#   UDPIPE_URL   https://lindat.mff.cuni.cz/services/udpipe/api/process
#   NAMETAG_URL  https://lindat.mff.cuni.cz/services/nametag/api/recognize
#
# Whichever value resolves is what /info reports and what `?deep=true` probes, so
# the health surface always names the host the pipeline actually calls. The same
# UDPIPE_URL name is used by atrium-translator, which calls the same service for
# vocabulary lemma matching — deliberately ONE name for one service, though a
# deployment may legitimately set them apart per workload.
UDPIPE_URL=
NAMETAG_URL=

# ── Image / provenance ────────────────────────────────────────────────────────
# Read by no Python — docker-compose.yaml interpolates these into the image tag
# and the build args. [compose only, by construction]
# Image tag used by docker-compose (matches para_config.txt [tool] on release)
ATRIUM_VERSION=dev
# Stamped into paradata as runner_ref
ATRIUM_RUNNER_REF=dev

# ── HTTP surface ──────────────────────────────────────────────────────────────
# [compose + k8s] Port the api service binds, and the port service/healthcheck.py
# probes inside the container. docker-compose.yaml maps "${PORT:-8000}:${PORT:-8000}",
# so changing it here moves listener, published port and HEALTHCHECK together. In
# Kubernetes, change `containerPort` in the same edit. (atrium-project#58)
PORT=8000
# [k8s / -e only] Bind address. Leave at 0.0.0.0. service/healthcheck.py always
# probes 127.0.0.1 by design and never reads HOST, so 127.0.0.1 here gives a
# container that reports HEALTHY to every probe while being unreachable from
# outside it. This is the one value whose failure mode is silent.
HOST=0.0.0.0
# [k8s / -e only] CSV of CORS origins. The CODE default is `*` — wide open —
# because service/atrium_service.py:370 falls back to it when unset. Unlike
# alto-postprocess and page-classification, this repo's compose file does not
# declare ALLOWED_ORIGINS at all, so `docker compose --profile api up` serves
# every origin. Set it explicitly for any deployment reachable from a browser.
ALLOWED_ORIGINS=*
# [k8s / -e only] Canonical upload limit in megabytes. 5 is THIS repo's built-in
# (service/api.py:43, `resolve_max_upload_mb(5.0)`) and the LOWEST of the five —
# alto 25, llm-enrich 10, nlp-enrich 5, page-classification 10, translator 50.
# Enforced on /enrich, /enrich_text, /rescale and the document_json part alike.
MAX_UPLOAD_MB=5
# DEPRECATED — do not set. A byte-valued fallback kept working for one release for
# callers that already exported it (strategy §4.5); MAX_UPLOAD_MB wins whenever
# both are present (service/atrium_service.py:353-364). Listed commented-out so
# the contract is complete and the deprecation is discoverable.
# MAX_UPLOAD_BYTES=
# [k8s / -e only] Path the container's own HEALTHCHECK probes. Change it only
# alongside the route itself.
HEALTHCHECK_PATH=/health

# ── Lifecycle ─────────────────────────────────────────────────────────────────
# [k8s / -e only] Seconds uvicorn waits for in-flight requests after SIGTERM.
# Raise together with the deployment's grace period (terminationGracePeriodSeconds
# in k8s, see docs/k8s_deployment.md in the hub; stop_grace_period under compose,
# already 60s here). Note serve_lifecycle's own tracked-job drain runs ON TOP of
# this for a /jobs run — budget both.
GRACEFUL_SHUTDOWN_S=20
# [k8s / -e only] Filesystem auto-reload. Development only — never in a
# deployment. Deliberately NOT wired into any compose or k8s template.
RELOAD=false

# ── Job limits ────────────────────────────────────────────────────────────────
# This repo is the only one of the five with an asynchronous job API, so it is the
# only one with a queue to size. These are genuine operator knobs.
#
# [OVERRIDDEN] Concurrent pipeline jobs. Each spawns a subprocess, so this bounds
# real CPU — and it also shields the shared LINDAT endpoints from this deployment.
# docker-compose.yaml:44 sets it as a literal "2", so `MAX_CONCURRENT_JOBS=8
# docker compose up` is silently overridden back to 2 today.
MAX_CONCURRENT_JOBS=2
# [k8s / -e only] Seconds a single job may run before it is killed.
API_JOB_TIMEOUT=600
# [k8s / -e only] Words accepted in one synchronous request before the service
# refuses the document with 413.
MAX_WORDS=30000
# [k8s / -e only] Largest width/height /rescale will accept as a target.
MAX_RESCALE_DIM=100000
# [k8s / -e only] Where per-job workspaces are created. Defaults to
# <repo>/TEMP/api_jobs. Point this at a volume with room for concurrent jobs — in
# Kubernetes, at a mounted emptyDir or PVC rather than the container filesystem.
API_JOBS_ROOT=./TEMP/api_jobs
# [k8s / -e only] Keep job workspaces after completion. Debugging only: nothing
# cleans them up afterwards, so a busy deployment fills its disk. Unset (blank)
# is the code default; 1/true/yes/on enable it.
API_KEEP_WORKSPACES=
# [OVERRIDDEN] Keyword backend used when a request does not name one.
# docker-compose.yaml:45 sets it as a literal "keybert", so .env cannot change it
# under compose today.
DEFAULT_KW_METHOD=keybert

LOG_LEVEL=INFO
