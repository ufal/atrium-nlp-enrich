# atrium-nlp-enrich — service-layer environment contract (atrium-project#60).
#
# Copy to `.env` and edit. docker-compose reads `.env` from the repo root
# automatically. Every variable `service/` reads is listed here; batch-pipeline
# knobs live in config_api.txt instead, which is the split #60 asks for.
#
# NOTE: this is NOT annotation/env.example — that file configures the annotation
# stack and has a different scope. Keep the two separate.

# ── Backing services (atrium-project#63) ──────────────────────────────────────
# Attachable endpoints: point these at a self-hosted UDPipe 2 / NameTag 3, or at
# a local stub, with no code change. Leave BLANK (not deleted) to use the LINDAT
# defaults declared in config_api.txt — blank means "unset" everywhere that
# reads them, which is why docker-compose.yaml passes them as ${VAR:-}.
# Precedence: --url flag > this variable > config_api.txt > module constant.
# The same UDPIPE_URL name is used by atrium-translator, which calls the same
# service for lemma matching; one deployment may legitimately set them apart.
UDPIPE_URL=
NAMETAG_URL=

# ── Image / provenance ────────────────────────────────────────────────────────
# Image tag used by docker-compose (matches para_config.txt [tool] on release)
ATRIUM_VERSION=dev
# Stamped into paradata as runner_ref
ATRIUM_RUNNER_REF=dev

# ── HTTP surface ──────────────────────────────────────────────────────────────
# Port the api service binds, and the port service/healthcheck.py probes inside
# the container. Changing it here moves the listener, the published port and the
# container's own HEALTHCHECK together, because docker-compose.yaml maps
# "${PORT:-8000}:${PORT:-8000}".
PORT=8000
# Bind address. Leave at 0.0.0.0: healthcheck.py always probes loopback and never
# reads HOST, so 127.0.0.1 gives a container that reports healthy and is
# unreachable from outside it.
HOST=0.0.0.0
# CORS for the api profile
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5500
# Canonical upload limit. MAX_UPLOAD_BYTES is a DEPRECATED fallback kept for
# older callers (service/atrium_service.py prefers the MB form) — set this one.
MAX_UPLOAD_MB=50
# DEPRECATED — do not set. Kept only so older callers that exported it still
# work; MAX_UPLOAD_MB wins whenever both are present. Listed here so the
# contract is complete and the deprecation is discoverable, not to offer a
# second knob.
# MAX_UPLOAD_BYTES=
# Path the container's HEALTHCHECK probes; change only alongside the route.
HEALTHCHECK_PATH=/health

# ── Lifecycle ─────────────────────────────────────────────────────────────────
# Seconds uvicorn waits for in-flight requests on SIGTERM. Raise together with
# the deployment's grace period (see docs/k8s_deployment.md in the hub).
GRACEFUL_SHUTDOWN_S=20
# Root logger level for the `python -m service.api` start path
LOG_LEVEL=INFO
# Filesystem auto-reload — development only, never in a deployment
RELOAD=false

# ── Job limits ────────────────────────────────────────────────────────────────
# Concurrent pipeline jobs; each spawns a subprocess, so this bounds real CPU.
MAX_CONCURRENT_JOBS=2
# Words accepted per request before the service refuses the document
MAX_WORDS=200000
# Seconds a single job may run before it is killed
API_JOB_TIMEOUT=3600
# Longest edge an uploaded page image is rescaled to
MAX_RESCALE_DIM=4000
# Where per-job workspaces are created
API_JOBS_ROOT=/tmp/atrium-nlp-jobs
# Keep job workspaces after completion — debugging only; they are not cleaned up
API_KEEP_WORKSPACES=false
# Default keyword method when a request does not name one
DEFAULT_KW_METHOD=keybert
